<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.pathland</groupId>
    <artifactId>pathland-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>Pathland Java</name>
    <description>
        Framework-agnostic Java libraries for the Pathland UI protocol: a SwiftUI-like
        view DSL with Angular-style signals/computed/effects, a fine-grained opcode
        emitter, the wire codec, FFM ring interop, a reusable HTML renderer, and
        cross-platform state stores. Usable from Spring Boot, Quarkus, or desktop apps.
    </description>

    <modules>
        <module>pathland-view</module>
        <module>pathland-render-html</module>
        <module>pathland-state-redis</module>
        <module>pathland-quarkus-demo</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- ScopedValue (JEP 506) is final only in Java 25; FFM (JEP 454) is final in 22.
             Quarkus >= 3.18 bundles ASM that reads Java 25 class files, so dev mode works. -->
        <maven.compiler.release>25</maven.compiler.release>
        <quarkus.version>3.39.1</quarkus.version>
        <junit.version>5.10.2</junit.version>
        <lettuce.version>6.4.1.RELEASE</lettuce.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.lettuce</groupId>
                <artifactId>lettuce-core</artifactId>
                <version>${lettuce.version}</version>
            </dependency>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>