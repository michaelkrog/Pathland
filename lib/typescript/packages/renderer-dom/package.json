{
  "name": "@pathland/renderer-dom",
  "version": "1.0.0",
  "description": "Pathland DOM Renderer - Unified renderer for browser DOM and JSDOM",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "prepublish": "npm run build"
  },
  "keywords": [
    "pathland",
    "renderer",
    "dom",
    "jsdom",
    "ui",
    "browser",
    "server"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@pathland/protocol": "^1.0.0"
  },
  "peerDependencies": {
    "jsdom": "^20.0.0 || ^21.0.0 || ^22.0.0 || ^23.0.0 || ^24.0.0 || ^25.0.0"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "jsdom": "^24.0.0"
  }
}
